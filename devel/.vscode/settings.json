{
    // Files
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true
    },
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.watcherExclude": {
        "**/.git/**": true
    },

    // Python
    "python.analysis.autoSearchPaths": false,
    "python.analysis.extraPaths": [
        "${workspaceFolder}/LogWatcher"
    ],
    "python.analysis.typeCheckingMode": "off",  // TODO
    // (lint/format)
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
    },
    "black-formatter.args": [
        "--config=${workspaceFolder}/devel/black.toml"
    ],
    "flake8.args": [
        "--config=${workspaceFolder}/devel/flake8.toml"
    ],
    "isort.args": [
        "--settings=${workspaceFolder}/devel/isort.toml"
    ],

    // Shell (& Cie)
    "shellcheck.customArgs": [
        "-x",
    ],
    "[shellscript]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 4,
    },
}
